{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone"
  ],
  "timezone": "Europe/Stockholm",
  "minimumReleaseAge": "7 days",
  "commitMessagePrefix": "Renovate/",
  "commitMessageTopic": "{{depName}}",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate",
  "labels": [
    "kind/update",
    "renovate"
  ],
  "ignorePaths": [
    ".vscode/",
    "studies/",
    "workshops/",
    "brand/",
    "architecture/"
  ],
  "enabledManagers": [
    "helmv3",
    "kubernetes"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump Helm Chart version when dependencies update",
      "managerFilePatterns": [
        "/(^|/)Chart\\.yaml$/"
      ],
      "matchStrings": [
        "version:\\s*(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "main-chart-version",
      "datasourceTemplate": "helm",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge patch and minor updates",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "Do not automerge major or minor updates for Authentik and Immich",
      "matchPackageNames": [
        "/(^|\\/)(authentik|goauthentik|immich)([-\\/]|$)/i"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "automerge": false
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/kubernetes/manifests/.+\\.yaml/"
    ]
  }
}